# Copy to .env and fill in from Back4App: App Settings -> Security & Keys
EXPO_PUBLIC_BACK4APP_APP_ID=your-application-id
# Any ONE of these keys works (REST API Key, JavaScript Key or Client Key)
EXPO_PUBLIC_BACK4APP_JS_KEY=your-javascript-key
# EXPO_PUBLIC_BACK4APP_REST_KEY=your-rest-api-key
# EXPO_PUBLIC_BACK4APP_CLIENT_KEY=your-client-key
# Optional, defaults to https://parseapi.back4app.com
# EXPO_PUBLIC_BACK4APP_SERVER_URL=https://parseapi.back4app.com
